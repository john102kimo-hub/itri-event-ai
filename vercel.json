{
  "rewrites": [
    { "source": "/event", "destination": "/event.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/training", "destination": "/training.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/geo", "destination": "/geo.html" }
  ],
  "functions": {
    "api/geo.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 60 },
    "api/training.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/geo?action=cron", "schedule": "0 1 * * *" },
    { "path": "/api/geo?action=cron", "schedule": "30 1 * * *" },
    { "path": "/api/geo?action=cron&calibrate=1", "schedule": "0 5 1 * *" },
    { "path": "/api/geo?action=cron&calibrate=1", "schedule": "0 12 1 * *" }
  ]
}
